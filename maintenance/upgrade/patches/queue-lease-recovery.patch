+func persistLeaseExpiry(s store.Store, task *model.Task, exhausted bool) error {
+	if !exhausted {
+		if deleteErr := s.TaskDelete(task.ID); deleteErr != nil && !errors.Is(deleteErr, types.ErrRecordNotExist) {
