+	queueCtx, cancel := context.WithCancelCause(ctx)
+	stop := func() { cancel(nil) }
+	t.Cleanup(stop)
+	memory, ok := NewMemoryQueue(queueCtx).(*fifo)
+	require.True(t, ok)
+	return WithTaskStore(queueCtx, memory, s), memory, stop
