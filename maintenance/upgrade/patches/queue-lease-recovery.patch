+			got, err := pq.Poll(ctx, 1, filterFnTrue)
+			require.NoError(t, err)
+			require.NotNil(t, got, "transient store failure must not complete the lease as stale")
+			assert.Equal(t, 1, q.Info(ctx).Stats.Running)
+		})
+	}
+}
